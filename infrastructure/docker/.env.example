PIH_API_PORT=3001
PIH_WEB_PORT=3000
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD_FILE=<absolute-secret-file-path>
PIH_API_IMAGE=<immutable-api-image-reference>
PIH_WEB_IMAGE=<immutable-web-image-reference>
PIH_API_ENV_FILE=<absolute-api-environment-file-path>
PIH_WEB_ENV_FILE=<absolute-web-environment-file-path>
PIH_WEB_UID=<numeric-uid-of-dedicated-pih-web-user>
PIH_WEB_GID=<numeric-gid-of-dedicated-pih-web-group>
PIH_CONNECTORS_CLIENT_GID=<numeric-gid-of-pih-connectors-clients>
