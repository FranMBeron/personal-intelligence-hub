# Resolve this numeric group with getent group pih-connectors-clients.
# Credential values are generated directly into the private installation file.
# Keep private credential material out of this tracked example.
NODE_ENV=production
CONNECTORS_SOCKET_PATH=/run/pih-connectors/web/connectors.sock
CONNECTORS_SOCKET_GID=
CONNECTORS_DATABASE_PATH=/var/lib/pih-connectors/connectors.sqlite
# Agent-capable entries (hermes-central) must set boundActorId to the owner actor UUID.
CONNECTORS_SERVICE_CREDENTIALS_JSON=
DEFAULT_TIME_ZONE=Etc/UTC
LOG_LEVEL=info
