NODE_ENV=production
AUTH_MODE=tailscale
DATABASE_URL=<postgresql-url-with-private-runtime-credential>
PIH_INTERNAL_AUTH_KEY=<shared-web-api-key-at-least-32-random-bytes>
CURSOR_SIGNING_KEY=<at-least-32-random-bytes>
ALLOWED_ORIGINS=<https-tailscale-serve-origin>
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
IDEMPOTENCY_RETENTION_HOURS=24
OUTBOX_RETENTION_DAYS=7
MAX_REQUEST_BODY_BYTES=1048576
