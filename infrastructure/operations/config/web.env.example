NODE_ENV=production
AUTH_MODE=tailscale
PIH_API_INTERNAL_URL=http://api:3001
PUBLIC_ORIGIN=<https-tailscale-serve-origin>
PIH_INTERNAL_AUTH_KEY=<shared-web-api-key-at-least-32-random-bytes>
TAILSCALE_ALLOWED_USERS=<login=actor-uuid-comma-separated>
# Every Tailscale identity mode requires this private socket; Tailscale Serve
# targets unix:/run/pih-web/proxy/web.sock on the host. TCP never carries identity.
PIH_WEB_TRUSTED_PROXY_SOCKET=/run/pih-web-proxy/web.sock
HOSTNAME=0.0.0.0
PORT=3000
MAX_UPLOAD_BODY_BYTES=10485760
MAX_CONCURRENT_AGENT_OPERATIONS=2
UPSTREAM_TIMEOUT_MS=5000
AGENT_REQUESTS_PER_MINUTE=0
HERMES_INTERNAL_URL=<optional-private-hermes-url>
HERMES_SERVICE_TOKEN=<optional-private-hermes-service-token>
HERMES_DASHBOARD_URL=<optional-private-dashboard-url>
# Private connectors (see docs/deployment/private-tailscale.md). Leave
# CONNECTORS_ENABLED unset or false to disable; then omit every CONNECTORS_* line.
CONNECTORS_ENABLED=<true-or-false>
CONNECTORS_SOCKET_PATH=/run/pih-connectors/connectors.sock
CONNECTORS_SERVICE_TOKEN=<private-web-connectors-service-credential>
CONNECTORS_DELEGATED_JWT_KEY=<32-byte-base64url-key-distinct-from-internal-auth-key>
CONNECTORS_HUMAN_AUTH_MODE=<tailscale-localapi-or-oidc>
# tailscale-localapi mode only:
CONNECTORS_TAILSCALE_LOCALAPI_SOCKET=<absolute-tailscaled-localapi-socket-path>
CONNECTORS_TAILSCALE_ALLOWED_USERS=<login=actor-uuid-comma-separated>
# oidc mode only (omit the tailscale-localapi lines above):
# CONNECTORS_OIDC_ISSUER=<https-issuer-url>
# CONNECTORS_OIDC_AUDIENCE=<audience>
# CONNECTORS_OIDC_JWKS_URI=<https-jwks-url>
