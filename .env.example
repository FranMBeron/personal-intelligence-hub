# Copy to an ignored .env file and replace every placeholder locally.
NODE_ENV=<development-or-production>
AUTH_MODE=<oidc-or-tailscale>
DATABASE_URL=<postgresql-connection-url>
OIDC_ISSUER=<https-url>
OIDC_AUDIENCE=<audience>
OIDC_JWKS_URI=<https-url>
OIDC_ALLOWED_ALGORITHMS=<RS256-or-ES256>
CURSOR_SIGNING_KEY=<at-least-32-random-bytes>
PIH_INTERNAL_AUTH_KEY=<shared-web-api-key-at-least-32-random-bytes>
TAILSCALE_ALLOWED_USERS=<login=actor-uuid-comma-separated>
PIH_WEB_TRUSTED_PROXY_SOCKET=<absolute-private-unix-socket-path-required-in-tailscale-modes>
ALLOWED_ORIGINS=<comma-separated-https-or-localhost-urls>
LOG_LEVEL=<info-or-another-supported-level>
IDEMPOTENCY_RETENTION_HOURS=<integer-at-least-24>
OUTBOX_RETENTION_DAYS=<integer-at-least-7>
MAX_REQUEST_BODY_BYTES=<api-request-byte-limit>
HOST=<api-bind-host>
PORT=<api-port>
PIH_API_INTERNAL_URL=<http://api:3001>
PUBLIC_ORIGIN=<https://private-application-origin>
MAX_UPLOAD_BODY_BYTES=<web-upload-request-byte-limit>
MAX_CONCURRENT_AGENT_OPERATIONS=<positive-integer>
UPSTREAM_TIMEOUT_MS=<bounded-milliseconds>
AGENT_REQUESTS_PER_MINUTE=<zero-to-disable-or-positive-integer>
HERMES_INTERNAL_URL=<https-url>
HERMES_SERVICE_TOKEN=<runtime-secret>
HERMES_DASHBOARD_URL=<https-url>
CONNECTORS_ENABLED=<true-or-false>
CONNECTORS_SOCKET_PATH=<absolute-connectors-socket-path>
CONNECTORS_SERVICE_TOKEN=<runtime-secret>
CONNECTORS_DELEGATED_JWT_KEY=<32-byte-base64url-key>
CONNECTORS_HUMAN_AUTH_MODE=<oidc-or-tailscale-localapi>
CONNECTORS_OIDC_ISSUER=<https-url>
CONNECTORS_OIDC_AUDIENCE=<audience>
CONNECTORS_OIDC_JWKS_URI=<https-url>
CONNECTORS_TAILSCALE_LOCALAPI_SOCKET=<absolute-tailscaled-localapi-socket-path>
CONNECTORS_TAILSCALE_ALLOWED_USERS=<login=actor-uuid-comma-separated>
NEXT_PUBLIC_PIH_PRODUCT_NAME=<Personal Intelligence Hub>
