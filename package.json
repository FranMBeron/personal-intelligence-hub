{
  "name": "personal-intelligence-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "overrides": {
      "esbuild@0.18.20": "0.25.12"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.scripts.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:compose": "vitest run infrastructure/docker/compose.test.ts",
    "test:ci-policy": "vitest run scripts/ci-policy.test.ts",
    "test:docker-policy": "vitest run infrastructure/docker/hardening.test.ts",
    "test:operations": "vitest run infrastructure/operations/operations.test.ts",
    "test:public-boundary": "vitest run scripts/public-boundary.test.ts",
    "test:public": "vitest run scripts/openapi.test.ts",
    "verify:secrets": "sh scripts/verify-no-secrets.sh",
    "verify:secrets:history": "sh scripts/verify-no-secrets.sh --history",
    "openapi:generate": "node --conditions=development --import tsx scripts/generate-openapi.ts",
    "openapi:check": "node --conditions=development --import tsx scripts/generate-openapi.ts --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @personal-intelligence-hub/database db:generate",
    "db:migrate": "pnpm --filter @personal-intelligence-hub/database db:migrate",
    "desktop:dev": "pnpm --filter @personal-intelligence-hub/desktop dev",
    "desktop:make": "pnpm --filter @personal-intelligence-hub/desktop make:mac"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
