{
  "name": "personal-intelligence-hub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:compose": "vitest run infrastructure/docker/compose.test.ts",
    "verify:secrets": "sh scripts/verify-no-secrets.sh",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @personal-intelligence-hub/database db:generate",
    "db:migrate": "pnpm --filter @personal-intelligence-hub/database db:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "10.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
