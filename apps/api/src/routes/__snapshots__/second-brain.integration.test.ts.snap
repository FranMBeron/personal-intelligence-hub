    "/v1/audit-events/{eventId}/compensations": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "eventId",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string",
            },
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 8,
              "type": "string",
            },
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string",
            },
          },
          {
            "in": "header",
            "name": "X-Origin-Channel",
            "required": true,
            "schema": {
              "enum": [
                "pih",
                "telegram",
                "hermes-web",
                "automation",
                "test",
              ],
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompensateAuditEventBody",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
